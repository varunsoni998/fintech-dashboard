{
  "manifest_version": 3,
  "name": "CustomHolidays – Grab Price",
  "version": "1.0.0",
  "description": "One click on a hotel booking page sends the exact final price to BusinessOS Price Compare.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grab this price for Price Compare",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://businessos-roan-iota.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://businessos-roan-iota.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dashboard.js"],
      "run_at": "document_idle"
    }
  ]
}
